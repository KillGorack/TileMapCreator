{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Launch TileMapCreator",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/TileMapCreator/bin/Debug/net8.0/TileMapCreator.dll",
      "cwd": "${workspaceFolder}/TileMapCreator",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ]
}